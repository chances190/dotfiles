{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    // Prohibited heavy orchestrator frameworks: oh-my-opencode, superpowers, ultrawork
    "openslimedit@latest",
    "opencode-dynamic-context-pruning"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.context7.com/mcp"
    }
  },
  // All model calls route through local Kompact proxy
  "provider": {
    "openrouter": {
      "baseURL": "http://localhost:7878/v1",
      "apiKey": "{env:OPENROUTER_API_KEY}"
    }
  }
}