{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    // "oh-my-openagent@latest",
    // "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": ""
      }
    }
  },
  "permission": {
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow",
    "task": "allow",
    "todowrite": "allow",
    "edit": "ask",
    "bash": {
      "*": "ask"
    }
  }
}