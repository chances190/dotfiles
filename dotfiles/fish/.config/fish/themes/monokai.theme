# Base text & structural elements
fish_color_normal white
fish_color_command green
fish_color_keyword cyan
fish_color_quote yellow
fish_color_redirection red
fish_color_end red
fish_color_error red --underline
fish_color_param white
fish_color_comment brblack --bold

# Advanced syntax & parameters
fish_color_operator red
fish_color_escape cyan
fish_color_autosuggestion 555     # Muted gray for suggestions
fish_color_valid_path yellow --underline

# User/Host/CWD styling (to match the clean Monokai look)
fish_color_cwd yellow
fish_color_cwd_root red
fish_color_user green
fish_color_host white
fish_color_host_remote yellow
fish_color_status red

# Selection and Search matches
fish_color_selection white --background=brblack
fish_color_search_match white --background=brblack

# Pager (Tab-completion menu) matching Zsh style
fish_pager_color_prefix green --bold --underline
fish_pager_color_completion white
fish_pager_color_description yellow --italics
fish_pager_color_progress brwhite --background=red
fish_pager_color_selected_background --background=brblack

# Resetting unneeded/inherited properties
fish_color_cancel -r
fish_color_history_current --bold