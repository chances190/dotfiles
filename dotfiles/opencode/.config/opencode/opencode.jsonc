{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "@tarquinen/opencode-dcp@latest"
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "disabled": false,
        "url": "https://mcp.context7.com/mcp"
      },
      "deepwiki": {
      	"type": "remote",
      	"disabled": false,
        "url": "https://mcp.deepwiki.com/mcp"
      }
    }
  },
  // Ask-everything baseline; per-agent rules in agents/*.md override this.
  // Permission reference: ./permissions-reference.md
  "permissions": [
    { "action": "*", "resource": "*", "effect": "ask" },
    { "action": "compress", "resource": "*", "effect": "allow" },
    { "action": "context7_*", "resource": "*", "effect": "allow" },
    { "action": "deepwiki_*", "resource": "*", "effect": "allow" },
    { "action": "shadcn_*", "resource": "*", "effect": "allow" },
  ],
  "default_agent": "ask",
  "agents": {
    "plan": { "disabled": true },
    "build": { "disabled": true },
    "general": { "disabled": true },
    "explore": { "disabled": true },
  },
}
