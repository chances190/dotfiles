{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "openslimedit@latest",
    "@tarquinen/opencode-dcp@latest"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.context7.com/mcp"
    }
  },
  "provider": {
    "openrouter": {
      "baseURL": "http://localhost:7878/v1",
      "apiKey": "{env:OPENROUTER_API_KEY}"
    }
  },
  "permission": {
    // Ask-everything baseline; permissions are defined per-agent in ~/.config/opencode/agents/ (agent rules win).
    // Permission reference per-agent in ./config/opencode/permissions-reference.md
    "*": "ask"
  }
}